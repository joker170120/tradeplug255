{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "statusCode": 308
    },
    {
      "has": [{ "type": "host", "value": "tradeplug255.vercel.app" }],
      "source": "/:path*",
      "destination": "https://tradeplug255.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/uploads/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/data/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/admin/:path*"
    },
    {
      "source": "/healthz",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/healthz"
    },
    {
      "source": "/robots.txt",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/sitemap.xml"
    },
    {
      "source": "/p/:path*",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/p/:path*"
    },
    {
      "source": "/:segment",
      "destination": "http://tradeplug255.167.233.117.168.sslip.io/:segment"
    }
  ]
}
